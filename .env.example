# Bu dosyayi kopyala -> .env yap (yerelde) veya Render'da "Environment"
# sekmesine tek tek gir. .env dosyasini asla GitHub'a yukleme.

# BotFather'dan aldigin token
TELEGRAM_BOT_TOKEN=

# Bildirimlerin gidecegi chat id. Ogrenmek icin: botuna Telegram'dan
# /start yaz, sonra tarayicida su adresi ac (TOKEN yerine kendi token'ini yaz):
# https://api.telegram.org/bot<TOKEN>/getUpdates
# donen JSON icinde "chat":{"id": ...} degerini buraya yaz.
TELEGRAM_CHAT_ID=

# Render'a deploy ettikten sonra Render'in sana verdigi genel URL
# (orn. https://safe-bot-xxxx.onrender.com). Bu ayarlanirsa, uygulama
# acilista Telegram webhook'unu otomatik kurar. Bos birakirsan webhook
# kurulmaz ve /watchlist, /near, /summary komutlari calismaz (ama
# tarama + bildirim gonderme yine calisir).
PUBLIC_BASE_URL=

# bsc | eth | base  (varsayilan: bsc)
CHAIN=bsc

# Opsiyonel: kendi RPC adresini kullanmak istersen (varsayilan public RPC)
RPC_URL=

# Render bunu otomatik ayarlar, yerelde denerken bos birakabilirsin (varsayilan 10000)
PORT=10000
